{
  "name": "@clubedge/authorization",
  "version": "0.30.0",
  "description": "Authorization the app enforces: who may do what to which resource, the roles behind it, and a deny-by-default authorizer.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./conformance": "./src/conformance.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@clubedge/core": "workspace:*",
    "@clubedge/db": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "clubedge": {
    "migrations": {
      "folder": "drizzle",
      "table": "__drizzle_migrations_authorization"
    }
  }
}
